# ---------------------------------------------------------------------------
# Amazon -> eBay Sell-First Arbitrage Platform
# Copy to .env and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="Arbitrage Platform"
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json | console
API_PREFIX=/api

# --- Security --------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please-generate-a-random-48-byte-value
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000

# Bootstrap operator account (created on first startup if it does not exist).
# Leave the password empty in production and create the user via CLI instead.
BOOTSTRAP_USER_EMAIL=operator@example.com
BOOTSTRAP_USER_PASSWORD=

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://arbitrage:arbitrage@localhost:5432/arbitrage

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Operating modes -------------------------------------------------------
# DEMO_MODE is forced ON automatically when no provider credentials are set.
DEMO_MODE=true
SIMULATION_MODE=true
AUTOMATION_LEVEL=2                # 0..4, see docs/architecture.md

# --- Provider credentials (optional; absence => demo providers) -------------
AMAZON_API_BASE_URL=
AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=DE

EBAY_API_BASE_URL=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE=EBAY_DE
EBAY_WEBHOOK_SECRET=

# --- Notifications (optional) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

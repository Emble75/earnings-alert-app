# ---------------------------------------------------------------------------
# Amazon -> eBay Sell-First Arbitrage Platform
# Copy to .env and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="Arbitrage Platform"
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json | console
API_PREFIX=/api

# --- Security --------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please-generate-a-random-48-byte-value
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000

# Bootstrap operator account (created on first startup if it does not exist).
# Leave the password empty in production and create the user via CLI instead.
BOOTSTRAP_USER_EMAIL=operator@example.com
BOOTSTRAP_USER_PASSWORD=

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://arbitrage:arbitrage@localhost:5432/arbitrage

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Operating modes -------------------------------------------------------
# DEMO_MODE is forced ON automatically when no provider credentials are set.
DEMO_MODE=true
SIMULATION_MODE=true
AUTOMATION_LEVEL=2                # 0..4, see docs/architecture.md

# --- Provider credentials (optional; absence => demo providers) -------------
AMAZON_API_BASE_URL=
AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=DE

# eBay: the App ID (Client ID) and Cert ID (Client Secret) from a keyset at
# developer.ebay.com -> Application Keys. These two alone enable reading live
# listings through the Browse API - real prices and real item numbers. They
# grant public read access only: they cannot list, sell or see an account, so
# they are safe to set while the system is in research mode.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# "production" or "sandbox". Sandbox keysets work immediately but hold almost
# no inventory; production keysets wait for eBay to verify the account. Keys
# from one environment do not work against the other.
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE=EBAY_DE
# Selling needs more than the two keys above: a user-consent token, reached
# through a gateway that speaks the Sell APIs. Until this is set, the system
# can read eBay but cannot trade on it.
EBAY_API_BASE_URL=
EBAY_REFRESH_TOKEN=
EBAY_WEBHOOK_SECRET=

# --- Notifications (optional) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

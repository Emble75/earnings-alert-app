# Copy to .env — placeholders only. Never commit real values.

# --- Server ---
PORT=8787
# Public origin used for share links (optional; the client falls back to window.location.origin)
PUBLIC_ORIGIN=http://localhost:5173

# --- Database ---
# Unset  -> embedded PGlite (Postgres-in-WASM), persisted in ./.data/pglite. Zero setup.
# Set    -> any PostgreSQL 14+ (Neon, Supabase, Fly Postgres, local).
DATABASE_URL=
# Set to "memory" for a throwaway in-memory PGlite (tests).
DB_MODE=

# --- Football data ---
# sample | opendata | statsbomb | wikidata | file   (default: sample). statsbomb = free open data, no key.
FOOTBALL_PROVIDER=sample
# Sync automatically every N hours (0 = off). Ignored for the sample provider.
SYNC_INTERVAL_HOURS=0
# opendata (transfers 1992-2022 + World Cup squads): cache of downloaded CSVs. Private/testing use only (licence notes in docs).
OPENDATA_CACHE_DIR=.data/opendata-cache
# StatsBomb: local cache of downloaded files; MAX_MATCHES>0 limits matches per season for quick smoke runs.
STATSBOMB_CACHE_DIR=.data/statsbomb-cache
STATSBOMB_MAX_MATCHES=0
# Wikimedia requires an identifying User-Agent with contact info for Wikidata queries.
WIKIDATA_USER_AGENT="Pitchside/0.1 (https://example.com; you@example.com)"

# --- Admin ---
# Enables /admin and /api/admin/*. Generate: openssl rand -hex 32
ADMIN_TOKEN=

# --- Misc ---
LOG_LEVEL=info
